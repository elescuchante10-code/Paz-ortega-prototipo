# Never expose this value in browser code or commit it to Git.
DEEPSEEK_API_KEY=replace_with_your_key
# Optional. Defaults to https://api.deepseek.com
DEEPSEEK_BASE_URL=https://api.deepseek.com

# URLs públicas de los prototipos operativos embebidos (Legal Tech y Finanzas).
# En desarrollo local pueden apuntar a los puertos locales de esos proyectos.
# En producción deben ser URLs públicas (ej. Vercel) de esos mismos prototipos.
# Si se dejan vacías, la plataforma muestra un aviso en vez de un iframe roto.
NEXT_PUBLIC_LEGAL_URL=http://127.0.0.1:3002
NEXT_PUBLIC_FINANCE_URL=http://127.0.0.1:3003
